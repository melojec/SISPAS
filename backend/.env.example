# ─── Configurações gerais ────────────────────────────────────────────────────
SECRET_KEY=gerar-com-python-secrets-token-hex-50
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings_prod

# Hosts separados por vírgula (sem espaço, sem https://)
ALLOWED_HOSTS=sispas.com.br,www.sispas.com.br

# ─── Banco de dados ───────────────────────────────────────────────────────────
# Formato: postgresql://usuario:senha@host:porta/nome_db
# Em VPS local: postgresql://sispas_user:senha@localhost:5432/sispas_prod
DATABASE_URL=postgresql://sispas_user:senha-forte-aqui@localhost:5432/sispas_prod

# ─── CORS e CSRF (domínios com https://) ─────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://sispas.com.br,https://www.sispas.com.br
CSRF_TRUSTED_ORIGINS=https://sispas.com.br,https://www.sispas.com.br

# ─── Dev local (MariaDB) — não usar em produção ───────────────────────────────
# DEBUG=True
# DJANGO_SETTINGS_MODULE=config.settings
# DB_NAME=sispas_dev
# DB_USER=sispas
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
